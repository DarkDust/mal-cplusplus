{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build step3_env (debug)",
            "type": "process",
            "command": "make",
            "args": [
                "-B",
                "step3_env",
                "CXXFLAGS=-std=c++23 -fcxx-modules -g -O0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": "build"
        }
    ]
}